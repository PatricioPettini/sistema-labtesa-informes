{
  "name": "lab-informes",
  "version": "1.0.0",
  "description": "Sistema de generación de informes de laboratorio metalúrgico",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "npx nodemon server/index.js",
    "test": "node --test test/generators.test.js",
    "test:update": "node -e \"process.env.UPDATE_SNAPSHOTS='1';require('node:child_process').execSync('node --test test/generators.test.js',{stdio:'inherit'})\"",
    "build": "node build-frontend.js --prod",
    "build:dev": "node build-frontend.js",
    "build:watch": "node build-frontend.js --watch"
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "cors": "^2.8.5",
    "docx": "^8.5.0",
    "docxtemplater": "^3.68.7",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "multer": "^1.4.5-lts.1",
    "node-fetch": "^2.7.0",
    "pizzip": "^3.2.0",
    "puppeteer-core": "^25.4.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.1"
  }
}
